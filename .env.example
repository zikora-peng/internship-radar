# Copy to .env and fill in. NEVER store secrets anywhere else.
# tools/deploy.sh reads this file and pushes every value to GitHub Actions
# secrets for you. .env is gitignored.

# You provide these two (the only manual credential steps):
GROQ_API_KEY=gsk_...                      # console.groq.com -> API Keys
TELEGRAM_BOT_TOKEN=123456789:AA...        # @BotFather -> /newbot

# Filled in automatically — leave blank:
TELEGRAM_CHAT_ID=                         # discovered by tools/deploy.sh
GOOGLE_DOC_ID=                            # written by tools/setup_google.sh
